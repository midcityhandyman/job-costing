# Optional. Copy to .env to change the defaults. No secrets or API keys are used anywhere.
# Fractions, not percents: 0.35 means 35%.

# Default target gross margin. A per-job target_margin_pct in jobs.csv wins over this.
JOBCOST_TARGET_MARGIN=0.35
# Jobs projected above target but within this many points of it are put on WATCH.
JOBCOST_WATCH_BUFFER=0.03
# Below this reported progress a trade is not extrapolated; remaining work is held at estimate.
JOBCOST_MIN_PROGRESS=0.15
# A trade is named as a margin driver when its forecast is over estimate by this share...
JOBCOST_TRADE_OVERRUN_PCT=0.10
# ...and by at least this many dollars.
JOBCOST_TRADE_OVERRUN_MIN=250
# Number of recent progress snapshots used for the drift trend (minimum 3).
JOBCOST_TREND_WINDOW=4
